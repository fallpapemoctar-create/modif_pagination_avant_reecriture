# Normalize line endings across platforms
* text=auto eol=lf

# Keep specific binary files untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Windows-specific scripts can keep CRLF if needed
*.bat eol=crlf
*.cmd eol=crlf
